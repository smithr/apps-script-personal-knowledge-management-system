# always ignore these directories, regardless of extension
.git/**
node_modules/**

# ignore everything else by default…
**/**

# except these extensions
!appsscript.json
!**/*.gs
!**/*.js
!**/*.ts
!**/*.html

# local-only files that must not be pushed to Apps Script
backfill-titles.js
pkm-library-index.json
docs/**
.claude/**
